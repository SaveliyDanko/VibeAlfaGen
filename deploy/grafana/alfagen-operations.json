{
  "uid": "alfagen-operations",
  "title": "AlfaGen · Операции",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "alfagen",
    "operations"
  ],
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Latency PII-операций · p50",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "description": "Медиана времени PII-модуля за минуту: mask = новое/повторное маскирование, demask = восстановление, other = остальные исходы. В старых логах duration_ms округлён вниз; 0 означает <1 мс. Новая версия backend сохраняет дробные миллисекунды. Это не полное HTTP-время и не проверка SLA 1 с; p50 также не показывает медленный хвост. Отсутствие операций — Нет данных.",
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.5, {namespace=\"alfagen-prod\", service_name=\"backend\"} |= `\"msg\":\"pii_operation\"` | json outcome=\"outcome\", duration_ms=\"duration_ms\" | label_format kind=`{{ if eq .outcome \"demasked\" }}demask{{ else if or (eq .outcome \"masked_new\") (eq .outcome \"masked_existing\") }}mask{{ else }}other{{ end }}` | unwrap duration_ms | __error__=\"\" [1m]) by (kind)",
          "legendFormat": "p50 {{kind}}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "instant": false,
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "noValue": "Нет данных",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 7,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMax": 5
          },
          "decimals": 3,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "< 1 мс (старые логи)",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p50 demask"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p50 mask"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p50 other"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "maxDataPoints": 120,
      "interval": "1m"
    },
    {
      "id": 2,
      "title": "Сейчас · общий RPS",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "description": "Суммарный HTTP /process RPS всех клиентов и всех backend-реплик, среднее за минуту. Это не целевой RPS одного теста: параллельная нагрузка тоже входит.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"alfagen-production-backend\",operation=\"process\"}[1m]))",
          "legendFormat": "RPS",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "Нет данных",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 7,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "area",
        "wideLayout": true,
        "justifyMode": "auto",
        "text": {
          "valueSize": 22
        }
      }
    },
    {
      "id": 3,
      "title": "TPS (токенов/с)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "description": "Оценка ceil(UTF-8 bytes/4), только новые payload_id; повторы и demask не входят.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tokens_processed_total{job=\"alfagen-production-backend\"}[1m]) and on(job,instance) (up{job=\"alfagen-production-backend\"} == 1))",
          "legendFormat": "TPS",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:token/s",
          "min": 0,
          "noValue": "Нет данных",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 7,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "area",
        "wideLayout": true,
        "justifyMode": "auto",
        "text": {
          "valueSize": 22
        }
      }
    },
    {
      "id": 6,
      "title": "Запросы по статусам",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "description": "HTTP-статусы /process всех клиентов и всех backend-реплик; health-check исключён. Одновременные тесты суммируются.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total{job=\"alfagen-production-backend\",operation=\"process\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "Нет данных",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 7,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Пропускная способность: маскирование и демаскирование",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "description": "Завершённые PII-операции/с по событиям Loki, среднее за минуту. mask включает повтор исходника. other включает конфликты и отказы. При потерях логов подсчёт может отличаться от HTTP RPS. Пустой интервал — нет событий; отсутствие данных не подменяется нулём.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate({namespace=\"alfagen-prod\", service_name=\"backend\"} |= `\"msg\":\"pii_operation\"` | json outcome=\"outcome\" | label_format kind=`{{ if eq .outcome \"demasked\" }}demask{{ else if or (eq .outcome \"masked_new\") (eq .outcome \"masked_existing\") }}mask{{ else }}other{{ end }}` | __error__=\"\" [1m]))",
          "legendFormat": "{{kind}}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "instant": false,
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "Нет данных",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 7,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "demask"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mask"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "other"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "maxDataPoints": 120,
      "interval": "1m"
    },
    {
      "id": 8,
      "title": "Найдено ПД по типам (всего)",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 10
      },
      "description": "Сумма счётчиков текущих backend-реплик с момента их запуска; перезапуск сбрасывает соответствующий счётчик. Типы взяты из текущего каталога AlfaGen.",
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(sum by (type) (pii_findings_total{job=\"alfagen-production-backend\"}))",
          "legendFormat": "{{type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "Нет данных",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 7,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "sizing": "manual",
        "minVizHeight": 18,
        "maxVizHeight": 24,
        "minVizWidth": 0,
        "namePlacement": "left"
      }
    }
  ],
  "links": [
    {
      "title": "Логи",
      "type": "link",
      "url": "d/alfagen-logs/alfagen-logs",
      "keepTime": true
    }
  ]
}
